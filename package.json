{
  "name": "time-tracking-invoices",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w @tt/server\" \"npm run dev -w @tt/client\"",
    "build": "npm run build -w @tt/client && npm run build -w @tt/server",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces",
    "seed:example": "npm run seed:example -w @tt/server",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3": false
  }
}
